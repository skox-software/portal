NEON_AUTH_COOKIE_SECRET=
PORTAL_URL=http://localhost:3300

# --- CRM email (Pipeline / Inbox) ---
# Resend API key (also used by lib/email.ts when set).
RESEND_API_KEY=
# The From line for CRM mail. Must be on a domain verified in Resend.
CRM_FROM_EMAIL="Reiss at SKOX <reiss@skoxsoftware.com>"
# Signing secret of the email.received webhook (starts whsec_).
RESEND_WEBHOOK_SECRET=
# Optional: which workspace inbound mail belongs to, if there is ever more than one.
CRM_WORKSPACE_SLUG=
