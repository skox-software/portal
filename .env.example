DATABASE_URL=
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=
# The portal's public address, including the /portal base path.
# Production: https://www.skoxsoftware.com/portal
PORTAL_URL=http://localhost:3300/portal

# Stripe Checkout is optional: without these, invoices use their manual pay
# link. Use a restricted key (rk_) in production, not a secret key.
# The finance dashboard (/admin/finance) also needs READ on Balance (includes
# balance transactions), Payouts, Charges, PaymentIntents and
# Money management → Financial accounts (the business account balance), on top of what
# checkout needs. Without them its Stripe cards show "unavailable"; see
# docs/FINANCE.md.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# From the webhook endpoint in Stripe, or from `stripe listen` when local.
STRIPE_WEBHOOK_SECRET=

# Cold outreach from the pipeline (CAN-SPAM). Sending refuses without both.
# SKOX's postal address, printed in every cold email's footer.
SKOX_POSTAL_ADDRESS=
# Signs the unsubscribe links (/u/<token>). A long random string, e.g. `openssl rand -base64 32`.
# Changing it breaks every unsubscribe link already sent.
UNSUBSCRIBE_SECRET=

# Off by default. Do not enable until the mailing address and public opt-out
# route have been verified in production. The provider key must be scoped to
# the verified outreach.skoxsoftware.com domain; never use the transactional key.
COLD_OUTREACH_ENABLED=false
OUTREACH_RESEND_API_KEY=
# Signing secret of the Resend webhook for delivery reports (delivered, bounced, opened…),
# pointed at <portal>/api/resend/events. Resend → Webhooks → the endpoint → Signing secret (whsec_…).
RESEND_EVENTS_SECRET=

# Gmail opt-out forwarding destination on your Resend receiving domain.
OUTREACH_REPLY_COPY_ADDRESS=
# Optional receiving-capable key; otherwise uses RESEND_API_KEY.
RESEND_INBOUND_API_KEY=

# The preview builder (docs/prospects/preview-playbook.md) reads GET /api/lead-previews/queue and reports back with
# PATCH /api/lead-previews/<dealId>, sending `Authorization: Bearer <this>`. Without it the API answers 401.
# A long random string, e.g. `openssl rand -base64 32`; give the same value to the builder routine.
PREVIEW_SERVICE_SECRET=
