DATABASE_URL=
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=
# The portal's public address, including the /portal base path.
# Production: https://www.skoxsoftware.com/portal
PORTAL_URL=http://localhost:3300/portal

# Stripe Checkout is optional: without these, invoices use their manual pay
# link. Use a restricted key (rk_) in production, not a secret key.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# From the webhook endpoint in Stripe, or from `stripe listen` when local.
STRIPE_WEBHOOK_SECRET=
